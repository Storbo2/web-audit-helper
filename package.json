{
    "name": "web-audit-helper",
    "version": "2.1.1",
    "type": "module",
    "description": "Framework-agnostic web audit overlay for accessibility, SEO, semantic and responsive validation.",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        }
    },
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "license": "MIT",
    "author": "Storbo",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Storbo2/web-audit-helper.git"
    },
    "homepage": "https://github.com/Storbo2/web-audit-helper#readme",
    "bugs": {
        "url": "https://github.com/Storbo2/web-audit-helper/issues"
    },
    "keywords": [
        "accessibility",
        "audit",
        "a11y",
        "seo",
        "semantic-html",
        "web-audit",
        "overlay",
        "wcag",
        "lighthouse",
        "developer-tools",
        "quality-assurance",
        "responsive",
        "performance"
    ],
    "bin": {
        "wah": "./dist/wah-cli.mjs"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "peerDependencies": {
        "playwright": "^1.58.2"
    },
    "peerDependenciesMeta": {
        "playwright": {
            "optional": true
        }
    },
    "devDependencies": {
        "@playwright/test": "^1.61.1",
        "@types/jsdom": "^28.0.3",
        "@types/node": "^26.0.1",
        "@vitest/coverage-v8": "^4.1.9",
        "@vitest/ui": "^4.1.9",
        "http-server": "^14.1.1",
        "jsdom": "^29.1.1",
        "tsup": "^8.5.1",
        "typescript": "^6.0.3",
        "vite": "^8.1.0",
        "vitest": "^4.1.9"
    },
    "scripts": {
        "backup": "node scripts/git-backup.mjs",
        "backup:skip-ci": "node scripts/git-backup.mjs --skip-ci",
        "release:tag": "node scripts/git-release-tag.mjs",
        "typecheck": "tsc --noEmit",
        "prebuild": "node scripts/gen-wah-css.mjs",
        "build": "tsup --config tsup.config.ts",
        "postbuild": "node scripts/gen-bookmarklet.mjs",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:debug": "playwright test --debug",
        "test:coverage": "vitest run --coverage",
        "test:all": "npm run test && npm run test:e2e"
    },
    "allowScripts": {
        "esbuild@0.27.7": true
    },
    "dependencies": {
        "esbuild": "^0.28.1"
    }
}
